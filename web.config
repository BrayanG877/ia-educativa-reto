<?xml version="1.0" encoding="utf-8"?>
<configuration>
 <system.webServer>
    <!--
      Configuración para Azure App Service (Linux/Windows con Node moderno).

      IMPORTANTE: antes este archivo usaba el handler "iisnode", que está
      OBSOLETO y ya no existe en los App Service actuales. Al no encontrarlo,
      IIS devolvía 500/404 y el backend nunca arrancaba (el sitio mostraba la
      página de bienvenida de Azure).

      La forma correcta hoy es que IIS actúe como proxy inverso hacia el
      proceso Node que Azure lanza solo (vía el Startup Command / package.json).
      El web.config de abajo sólo se usa si el sitio corre sobre IIS (Windows);
      en Linux es ignorado.
    -->

    <!-- Habilitar compression -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Proxy inverso: enviar TODO al servidor Node (puerto que usa el proceso) -->
    <rewrite>
      <rules>
        <rule name="ProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:%HTTP_PLATFORM_PORT%/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <handlers>
      <!-- Ya no se registra iisnode (obsoleto). -->
      <remove name="WebDAV" />
    </handlers>

    <!-- Security headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="DENY" />
        <add name="X-XSS-Protection" value="1; mode=block" />
      </customHeaders>
    </httpProtocol>

    <!-- Static content caching -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>

    <!-- Error pages -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
