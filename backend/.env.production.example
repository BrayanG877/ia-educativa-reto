# ===========================================
# VARIABLES DE ENTORNO - PRODUCCIÓN
# ===========================================
# ⚠️ NO COMMITEAR ESTE ARCHIVO CON VALORES REALES
# Este es un template - copiar y completar con valores reales
#
# Nomenclatura verificada contra el código (backend/src/config/ai.config.js).
# Los nombres de abajo son EXACTAMENTE los que lee el código.

# Entorno
NODE_ENV=production
PORT=8080

# ===========================================
# PROVEEDOR DE IA  (AI_PROVIDER)
# ===========================================
# Elige uno: anthropic | gemini | groq | reto | openrouter | ollama
# Si se omite, el código usa 'groq' por defecto.
AI_PROVIDER=groq

# Respaldo automático entre proveedores (errores recuperables: 401/403/429/5xx/timeout).
AI_FALLBACK_ENABLED=true
# Orden de proveedores ALTERNATIVOS (separados por coma).
# OJO: la variable se llama AI_FALLBACK_PROVIDERS. NO existen 'AI_FALLBACK_ORDER'
# ni 'AI_TEMPERATURE' (no son alias en el código).
AI_FALLBACK_PROVIDERS=gemini,openrouter,anthropic

# --- Groq (gratuito, proveedor principal recomendado) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Gemini (gratuito, respaldo) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- OpenRouter (modelos :free) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Anthropic Claude (DE PAGO; no se usa por defecto) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- RETO PLTK (gateway compatible OpenAI; modelo por defecto grok-4.6) ---
# Endpoint por defecto: https://api.reto.pltk.mx/v1 (configurable con RETO_BASE_URL;
# solo se aceptan http/https). Solo se usa si AI_PROVIDER=reto. La clave es obligatoria.
RETO_KEY=
RETO_MODEL=grok-4.6

# --- Ollama (local, sin API key) ---
# OLLAMA_ENABLED: 'true' habilita Ollama. Por defecto DESHABILITADO.
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Parámetros del subsistema de IA ---
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=1
AI_MAX_INPUT_CHARS=5000
AI_MAX_OUTPUT_TOKENS=1000
AI_DEFAULT_TEMPERATURE=0.7
# Nivel de log del subsistema de IA: debug|info|warn|error|silent.
# OJO: la variable se llama AI_LOG_LEVEL (NO 'LOG_LEVEL').
AI_LOG_LEVEL=info

# --- Diagnóstico de proveedores en /health ---
AI_HEALTHCHECK=on
AI_HEALTH_TTL_MS=60000

# ===========================================
# AGENTE EDUCATIVO (pedagogía) — ambos DESACTIVADOS por defecto
# ===========================================
# Se activan SOLO con un valor afirmativo explícito: true|1|yes|on|si|sí.
AGENT_ENABLED=false
# La persistencia solo escribe si además AGENT_ENABLED=true y la migración
# database/migration_agent.sql está aplicada y verificada en RDS.
AGENT_PERSISTENCE_ENABLED=false

# ===========================================
# BASE DE DATOS Microsoft SQL Server
# ===========================================
DB_HOST=tu-servidor
DB_PORT=1433
DB_NAME=ia_educativa
DB_USER=tu_usuario
DB_PASSWORD=
# Tiempos de conexión (ms); el default del código es 60000/30000.
DB_CONNECT_TIMEOUT=60000
DB_REQUEST_TIMEOUT=30000

# ===========================================
# REDIS / VALKEY (caché, OPCIONAL)
# ===========================================
# Azure Managed Redis (*.redis.azure.net): puerto 10000, TLS, usuario 'default'.
# Azure Cache clásico (*.redis.cache.windows.net): puerto 6380, TLS.
# Local: 127.0.0.1:6379 sin TLS.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_TLS=false

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# Generar un secret seguro de 64+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=24h

# ===========================================
# CORS - FRONTEND
# ===========================================
FRONTEND_URL=https://tu-frontend.example.com

# ===========================================
# RATE LIMITING / LÍMITES
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_TOKENS_PER_REQUEST=1000
MAX_CONVERSATION_HISTORY=5
CACHE_TTL_SECONDS=3600

