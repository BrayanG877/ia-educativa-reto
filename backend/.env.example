# ============================================================
# IA EDUCATIVA - Ejemplo de variables de entorno
# Copia este archivo a `.env` y rellena TUS valores reales:
#   cp .env.example .env
# NUNCA subas `.env` a Git: contiene secretos.
# ============================================================

# --- Servidor ---
PORT=3001
NODE_ENV=development
# ============================================================
# PROVEEDOR DE IA  (AI_PROVIDER)
# ============================================================
# Elige uno: anthropic | gemini | groq | reto | openrouter | ollama
#
# Para PRUEBAS GRATUITAS usa un proveedor gratuito:
#   gemini      -> https://aistudio.google.com/apikey   (gratis, sin tarjeta)
#   groq        -> https://console.groq.com/keys        (gratis, sin tarjeta)
#   openrouter  -> https://openrouter.ai/keys           (modelos con sufijo :free)
#   ollama      -> https://ollama.com                   (local, 100% gratis, sin key)
#   reto        -> RETO PLTK (gateway compatible OpenAI; modelo grok-4.6)
#
# (herramientas)
# El proveedor elegido debe tener su API key configurada abajo, salvo
# `ollama`, que no usa key. Si falta, el backend arranca igual y el chat
# responde 503 con un mensaje claro indicando qué variable falta.
#
# RESPALDO AUTOMATICO: si el proveedor activo falla por un error recuperable
# (credenciales 401/403, cuota 429, saturado 5xx, timeout), el backend reintenta
# UNA vez con el siguiente proveedor CONFIGURADO segun AI_FALLBACK_PROVIDERS.
# No hay reintentos en bucle ni llamadas duplicadas.
AI_PROVIDER=groq

# --- Configuracion central del agente (todas opcionales, con defaults seguros) ---
# NOTA de nomenclatura: los nombres que lee el codigo son EXACTAMENTE los de
# abajo. NO se usan "AI_FALLBACK_ORDER" ni "AI_TEMPERATURE" (no existen en el
# codigo ni como alias); el orden del respaldo es AI_FALLBACK_PROVIDERS y la
# temperatura es AI_DEFAULT_TEMPERATURE.
# AI_FALLBACK_ENABLED: true|false. Activa/desactiva el respaldo entre proveedores.
AI_FALLBACK_ENABLED=true
# AI_FALLBACK_PROVIDERS: orden de proveedores ALTERNATIVOS (separados por coma)
# que se intentan cuando el proveedor ACTIVO falla. Se ignora el proveedor
# principal y cualquier nombre desconocido. (No confundir con el orden interno
# usado para elegir el activo cuando AI_PROVIDER falta: es una lista distinta.)
AI_FALLBACK_PROVIDERS=gemini,openrouter,anthropic
# AI_TIMEOUT_MS: tiempo maximo por solicitud a un proveedor (1000-120000).
AI_TIMEOUT_MS=30000
# AI_MAX_RETRIES: reintentos con proveedor alternativo (0-3).
AI_MAX_RETRIES=1
# AI_LOG_LEVEL: debug|info|warn|error|silent.
AI_LOG_LEVEL=info
# AI_MAX_INPUT_CHARS: tope de caracteres del mensaje (1-100000).
AI_MAX_INPUT_CHARS=5000
# AI_MAX_OUTPUT_TOKENS: tope de tokens de salida cuando el proveedor lo admite.
AI_MAX_OUTPUT_TOKENS=1000
# AI_DEFAULT_TEMPERATURE: 0.0 - 2.0. (El nombre AI_TEMPERATURE NO se usa.)
AI_DEFAULT_TEMPERATURE=0.7
# --- Agente tutor (pedagogia) ---
# Dos banderas INDEPENDIENTES, AMBAS desactivadas por defecto. Solo se activan
# con un valor afirmativo EXPLICITO: true | 1 | yes | on | si | sí.
# Cualquier otro valor (ausente, vacio, 'false', 'no', basura) => false.
#
# AGENT_ENABLED: 'true' activa el enriquecimiento del prompt con el plan
#   pedagogico de tutor.agent.js (diagnosticar/ensenar/practicar/evaluar).
#   Por defecto DESACTIVADO: el chat se comporta igual que antes.
AGENT_ENABLED=false
# AGENT_PERSISTENCE_ENABLED: 'true' habilita que el agente ESCRIBA evidencias
#   y dificultades en RDS (tablas agent_evidence / agent_difficulties).
#   Por defecto DESACTIVADO: no se realiza ninguna escritura. Actívalo SOLO
#   tras aplicar y verificar la migracion database/migration_agent.sql.
#
#   ACOPLAMIENTO: la persistencia solo tiene efecto si ADEMAS hay un plan, y
#   un plan solo existe si AGENT_ENABLED=true. Es decir, con AGENT_ENABLED=false
#   la persistencia nunca escribe nada, aunque AGENT_PERSISTENCE_ENABLED=true.
AGENT_PERSISTENCE_ENABLED=false
# --- Groq (gratuito, proveedor principal recomendado) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# --- Google Gemini (gratuito, proveedor secundario para respaldo) ---
# Clave: https://aistudio.google.com/apikey  (AIza...)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# --- OpenRouter (modelos :free) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# --- RETO PLTK (gateway compatible OpenAI; modelo por defecto grok-4.6) ---
# Endpoint por defecto: https://api.reto.pltk.mx/v1 (configurable con RETO_BASE_URL;
# solo se aceptan http/https). Solo se usa si AI_PROVIDER=reto. La clave es obligatoria.
RETO_KEY=
RETO_MODEL=grok-4.6
# --- Ollama (local, sin API key) ---
# OLLAMA_ENABLED: 'true' habilita Ollama. Por defecto DESHABILITADO: mientras no
# sea exactamente 'true', Ollama NO se selecciona como proveedor principal ni de
# respaldo, y no se comprueba su disponibilidad. Actívalo solo si ejecutas
# "ollama serve" en esta máquina. Tener OLLAMA_HOST/OLLAMA_MODEL NO lo habilita.
OLLAMA_ENABLED=false
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
# --- Anthropic Claude (DE PAGO; no se usa por defecto) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# --- Diagnostico de proveedores en /health ---
# 'off' desactiva la comprobacion ligera (listado de modelos) que /health hace
# de cada proveedor configurado. Por defecto activada, cacheada ~60s.
AI_HEALTHCHECK=on
AI_HEALTH_TTL_MS=60000
# ============================================================
# BASE DE DATOS Microsoft SQL Server
# ============================================================
DB_HOST=tu-servidor
DB_PORT=1433
DB_NAME=ia_educativa
DB_USER=tu_usuario
DB_PASSWORD=tu_password
# ============================================================
# REDIS / VALKEY (caché)
# Local (EC2, recomendado en AWS): REDIS_HOST=127.0.0.1 REDIS_PORT=6379
#   Sin TLS ni contraseña. El cache es OPCIONAL: si no está, la app sigue.
# Nota: los valores marcados como Azure abajo son compatibilidad heredada de
# la migración; en AWS se usa el Redis/Valkey local de la instancia.
# Azure Managed Redis: host *.redis.azure.net, puerto 10000, TLS,
#   REDIS_USERNAME=default y REDIS_PASSWORD=tu Access Key
# Azure Cache clásico: host *.redis.cache.windows.net, puerto 6380, TLS
# ============================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
# Pon REDIS_TLS=true sólo si apuntas a un Redis gestionado con TLS (se detecta solo por el host)
REDIS_TLS=false

# --- JWT (usa una cadena larga y aleatoria en producción) ---
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
JWT_EXPIRES_IN=24h
# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# --- Límites de IA / costos ---
MAX_TOKENS_PER_REQUEST=1000
MAX_CONVERSATION_HISTORY=5
CACHE_TTL_SECONDS=3600
# --- CORS ---
FRONTEND_URL=http://localhost:3000
